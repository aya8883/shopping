# Application
VITE_APP_NAME=Wain Awfar
VITE_APP_NAME_AR=وين أوفر؟
VITE_APP_SLOGAN=Compare. Save. Shop smarter.
VITE_APP_SLOGAN_AR=قارن. وفر. تسوق بذكاء.
VITE_DEFAULT_CITY=Riyadh
VITE_DEFAULT_COUNTRY=SA
VITE_DEFAULT_CURRENCY=SAR
VITE_DEFAULT_TIMEZONE=Asia/Riyadh
VITE_DEFAULT_LOCALE=ar

# Frontend URLs
VITE_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
VITE_SUPERTOKENS_API_DOMAIN=http://localhost:3001
VITE_WEBSITE_DOMAIN=http://localhost:5173

# PostgreSQL (app database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wain_awfar
POSTGRES_USER=wain_awfar
POSTGRES_PASSWORD=wain_awfar_dev_password

# Hasura
HASURA_GRAPHQL_DATABASE_URL=postgres://wain_awfar:wain_awfar_dev_password@postgres:5432/wain_awfar
HASURA_GRAPHQL_ADMIN_SECRET=wain_awfar_hasura_admin_secret_dev
# HS256 shared with SuperTokens access tokens (dev only — change in production)
# Uses SuperTokens core JWKS (asymmetric). For local Docker networking.
HASURA_GRAPHQL_JWT_SECRET={"jwk_url":"http://supertokens:3567/.well-known/jwks.json","claims_namespace":"https://hasura.io/jwt/claims"}
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=anonymous
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log

# SuperTokens core
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_POSTGRES_USER=supertokens
SUPERTOKENS_POSTGRES_PASSWORD=supertokens_dev_password
SUPERTOKENS_POSTGRES_DB=supertokens

# Auth service (Node / SuperTokens backend)
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_CORS_ORIGIN=http://localhost:5173
SUPERTOKENS_APP_NAME=Wain Awfar
JWT_ACCESS_TOKEN_SIGNING_KEY=wain-awfar-dev-jwt-secret-key-change-in-production-32chars

# OCR / AI (optional — not required for Phase 1–2)
OCR_PROVIDER=mock
OPENAI_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
LEAFLET_SERVICE_PORT=3010
VITE_LEAFLET_API_URL=http://localhost:3010
VITE_USE_MOCK_DATA=true
